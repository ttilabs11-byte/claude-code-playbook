{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "medium"
  },
  "outputStyle": "Concise",
  "autoCompactEnabled": true,
  "cleanupPeriodDays": 90,
  "statusLine": { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/statusline.mjs\"", "padding": 0 },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(//**/.env)",
      "Read(//**/.env.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(pip install *)",
      "PowerShell(pip install *)",
      "Bash(python -m pip install *)",
      "PowerShell(python -m pip install *)",
      "Bash(npm install -g *)",
      "PowerShell(npm install -g *)",
      "Bash(winget install *)",
      "PowerShell(winget install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/shell-guard.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/edit-boundary.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/edit-boundary.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/log-guard.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/session-resume.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          { "type": "command", "command": "node \"{{CLAUDE_HOME}}/scripts/config-audit.mjs\"", "timeout": 10 }
        ]
      }
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults"
    ]
  }
}
